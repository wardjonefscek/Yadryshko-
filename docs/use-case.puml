@startuml use-case
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Arial

actor "Конструктор" as CON
actor "Технолог печати" as TECH
actor "Разработчик" as DEV
actor "Администратор\nсервера" as ADM

rectangle "Cad+ v1.0 — проектирование и топологическая оптимизация" {
  usecase "UC-01: Создать параметрический\nнаборный каркас" as UC01
  usecase "UC-03: Импортировать STEP" as UC03
  usecase "UC-04: Выполнить топологическую\nоптимизацию детали" as UC04
  usecase "UC-09: Экспортировать деталь\n(STL или DXF)" as UC09
  usecase "UC-12: Вести библиотеку материалов\nи профилей принтеров" as UC12
  usecase "UC-13: Настроить параметры\nи пресеты решателя" as UC13
  usecase "UC-14: Просмотреть логи расчётов" as UC14
  usecase "UC-15: Управлять очередью\nзаданий сервера" as UC15
  usecase "UC-16: Рассчитать крыло\nи лонжероны" as UC16

  usecase "UC-02: Применить шаблон каркаса" as UC02
  usecase "UC-05: Проверить входные\nданные задачи" as UC05
  usecase "UC-06: Построить расчётную\nсетку и ГУ" as UC06
  usecase "UC-07: Продолжить расчёт\nс контрольной точки" as UC07
  usecase "UC-08: Выполнить расчёт на\nдомашнем сервере (v2.0)" as UC08
  usecase "UC-10: Компенсировать\nдопуск или посадку" as UC10
  usecase "UC-11: Проверить\nизготовимость" as UC11
}

actor "Внешняя\nCAD-система" as EXT <<External>>
actor "Слайсер или\nстанок ЧПУ" as SL <<External>>

CON --> UC01
CON --> UC16
CON --> UC03
CON --> UC04
CON --> UC09
TECH --> UC09
TECH --> UC12
DEV --> UC13
DEV --> UC14
ADM --> UC14
ADM --> UC15

UC01 <.. UC02 : <<extend>>
UC04 ..> UC05 : <<include>>
UC04 ..> UC06 : <<include>>
UC04 <.. UC07 : <<extend>>
UC04 <.. UC08 : <<extend>>
UC09 ..> UC10 : <<include>>
UC09 ..> UC11 : <<include>>

UC03 <--- EXT : STEP-файл
UC09 ---> SL : STL / DXF
@enduml
